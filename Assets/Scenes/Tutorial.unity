  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 103427079}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 5fabe4d21e67a064086b449bda24ed3d, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::TutorialManager
  currentStep: 0
  dialogueBoxPrefab: {fileID: 5033743395083517000, guid: a824923aca3c02746bd27f907fc584e3, type: 3}
  canvasObj: {fileID: 278752123}
  playerRuntimeSet: {fileID: 11400000, guid: 35d9d90b045664a289cbdc748927308e, type: 2}
  introLines:
  - welcome to the tutorial round! I will be teaching you how to play
  - let's start off easy an try picking up the water. press [X] to pick up and drop
    items
  pickupLines: []
  waterOnlyLines:
  - great! now lets give some water to the community. each player should drop a water
    into their bin
  - press [A] to jump and remember to press [X] to pick up and drop items
  plantingLines:
  - 'yay! your reputation has increased! giving water to the community increases
    your reputation by 10 '
  - now lets try and give the community something better.
  - Take a water and drop it near the planting station to get a plant and then drop
    that in your bin
  cookingLines:
  - now your reputation has increased even more. look at your communities!
  - now lets try and give the community something EVEN  BETTER. and then drop that
    in your bin
  - 'Use the cooking station to turn a plant into food '
  stealLines:
  - nice! if you want to be a little mean... you can STEAL from another players
  - press [B] to steal. but be careful! theres a cooldown on your steal so use it
    wisely
  - we will proceed once EVERYONE has stolen at least once
  giveLines:
  - you can also be nice... you can GIVE to another player
  - press [Y] to give. we will proceed once EVERYONE has given at least once
  spotlightLines:
  - you can steal and give all you want...
  - but be aware... If you are caught by the camera... the world may or may not see
    exactly what you have done
  yodelLines:
  - YODEL
  plantingStation: {fileID: 1496258290}
  cookingStation: {fileID: 1265355021}
  spotlight: {fileID: 6122114769769476525}
  arrowPickupStation: {fileID: 832508169}
  arrowPlantingStation: {fileID: 622782498}
  arrowCookingStation: {fileID: 627038654}
  playerBinArrows:
  - {fileID: 618010750}
  - {fileID: 281051797}
  - {fileID: 542866472}
  - {fileID: 1591674259}
